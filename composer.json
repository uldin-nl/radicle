{
  "name": "uldin/radicle",
  "type": "package",
  "description": "Uldin Radicle package",
  "license": "MIT",
  "authors": [
    {
      "name": "Uldin",
      "email": "info@uldin.nl"
    }
  ],
  "autoload": {
    "psr-4": {
      "Uldin\\Radicle\\": "src/"
    },
    "files": [
      "src/legacy.php"
    ]
  },
  "require": {
    "php": "^8.0",
    "spatie/ignition": "^1.12"
  },
  "extra": {
    "acorn": {
      "providers": [
        "Uldin\\Radicle\\Providers\\FlareServiceProvider",
        "Uldin\\Radicle\\Providers\\AcfServiceProvider",
        "Uldin\\Radicle\\Providers\\LoginServiceProvider"
      ],
      "aliases": {
        "Flare": "Uldin\\Radicle\\Facades\\Flare",
        "Acf": "Uldin\\Radicle\\Facades\\Acf"
      }
    }
  },
  "replace": {
    "outlawz-team/radicle": "self.version"
  }
}
